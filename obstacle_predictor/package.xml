<?xml version="1.0"?>
<package format="3">
  <name>obstacle_predictor</name>
  <version>0.1.0</version>
  <description>Prediction node for dynamic obstacles (stateless, single-request per obstacle).</description>

  <maintainer email="joseriyancyriac@gmail.com">Riyan Cyriac Jose</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <build_depend>ament_cmake_python</build_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_dynamic_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>